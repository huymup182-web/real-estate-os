# Mẫu biến môi trường của AI Real Estate OS.
# Tạo .env bằng: sh scripts/setup-env.sh (hoặc copy file này thành .env rồi điền giá trị).
# KHÔNG commit file .env. Mô tả chi tiết: docs/environment.md

NODE_ENV=development

# Mức log của backend: fatal | error | warn | log | debug | verbose (mặc định log)
LOG_LEVEL=log

# Số proxy tin cậy trước backend (0 khi gọi thẳng; 1 khi sau một load balancer/reverse proxy)
TRUST_PROXY_HOPS=0

# Token đọc GET /api/v1/metrics (TASK-158, docs/monitoring.md). Để trống thì tắt endpoint.
# Ít nhất 32 ký tự, sinh bằng: openssl rand -hex 32
METRICS_TOKEN=

# PostgreSQL (dùng cho docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=real_estate_os
POSTGRES_PORT=5432

# Cổng mở ra máy host
BACKEND_PORT=3000
ADMIN_PORT=3001

# Chuỗi kết nối PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=

# Khoá ký JWT, chuỗi ngẫu nhiên tối thiểu 32 ký tự, khác nhau cho mỗi môi trường
JWT_SECRET=

# Máy chủ SMTP gửi email (mã đặt lại mật khẩu). Bắt buộc ở production
SMTP_HOST=
SMTP_PORT=587
# true: TLS ngay từ đầu (cổng 465); false: STARTTLS
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Địa chỉ người gửi, vd no-reply@ten-mien.vn
MAIL_FROM=

# Cổng Mailpit (hộp thư giả cho dev) mở ra máy host
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Object storage lưu ảnh BĐS (S3 / Cloudflare R2 / MinIO). Để trống STORAGE_BUCKET = không upload ảnh (chỉ ngoài production)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Endpoint S3-compatible, vd https://<account_id>.r2.cloudflarestorage.com; để trống với AWS S3
STORAGE_ENDPOINT=
# Region (AWS S3), mặc định auto (R2)
STORAGE_REGION=
# true với MinIO
STORAGE_FORCE_PATH_STYLE=false
# Địa chỉ CDN đọc ảnh, vd https://cdn.ten-mien.vn; để trống = backend cấp link đọc có hạn
STORAGE_PUBLIC_URL=

# Khoá API của nhà cung cấp LLM, chỉ backend được dùng. Để trống = tắt tính năng AI
AI_API_KEY=
# Nhà cung cấp LLM (hiện có: anthropic), model, gốc URL API; để trống = mặc định
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
# Thời gian chờ LLM (ms, mặc định 60000) và số lượt AI tối đa của một người trong 24 giờ (mặc định 100)
AI_TIMEOUT_MS=
AI_USER_DAILY_LIMIT=

# Service account Firebase Cloud Messaging (file JSON mã hoá base64, vd `base64 -w0 service-account.json`).
# Để trống = không đẩy thông báo tới thiết bị, chỉ lưu hộp thư
FCM_CONFIG=

# Mật khẩu chung cho tài khoản demo khi chạy `npm run seed` trong database/ (chỉ môi trường dev, tối thiểu 8 ký tự)
SEED_DEMO_PASSWORD=

# Sao lưu database (TASK-157, docs/backup.md): `npm run backup -- create` trong backend/.
# Thư mục giữ bản sao lưu trên máy (mặc định backups/) và số ngày giữ ở đó (mặc định 7)
BACKUP_DIR=
BACKUP_KEEP_DAYS=
# Kho lưu trữ ở nơi khác (S3 / R2 / MinIO), khoá riêng chỉ có quyền ghi. Bắt buộc ở production
BACKUP_BUCKET=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_ENDPOINT=
BACKUP_REGION=
BACKUP_FORCE_PATH_STYLE=false
BACKUP_PREFIX=database/
# URL ping sau mỗi lần sao lưu thành công (dịch vụ dead man's switch, TASK-158). Để trống thì không gọi
BACKUP_HEARTBEAT_URL=
