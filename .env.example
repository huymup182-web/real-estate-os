# Mẫu biến môi trường của AI Real Estate OS.
# Copy thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# PostgreSQL (dùng cho docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=real_estate_os
POSTGRES_PORT=5432

# Cổng mở ra máy host
BACKEND_PORT=3000
ADMIN_PORT=3001

# Chuỗi kết nối PostgreSQL khi chạy backend ngoài Docker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_estate_os

# Khoá ký JWT. Dùng chuỗi ngẫu nhiên dài, khác nhau cho mỗi môi trường
JWT_SECRET=

# Khoá truy cập object storage (S3 / Cloudflare R2)
STORAGE_KEY=

# Khoá API của nhà cung cấp LLM, chỉ backend được dùng
AI_API_KEY=

# Cấu hình Firebase Cloud Messaging
FCM_CONFIG=
