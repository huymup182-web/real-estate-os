# Biến triển khai cho docker-compose.yml (TASK-160, docs/deployment.md). Không phải secret.
# Copy thành deploy/.env trên máy chủ. deploy.sh tự cập nhật IMAGE_TAG mỗi lần triển khai.

# Commit git của bản đang chạy (tag image trên GHCR)
IMAGE_TAG=
IMAGE_REGISTRY=ghcr.io/huymup182-web

# Tên miền đã trỏ DNS (bản ghi A/AAAA) về máy chủ. Caddy tự xin chứng chỉ HTTPS.
API_DOMAIN=
ADMIN_DOMAIN=
# Email nhận thông báo của Let's Encrypt
ACME_EMAIL=
