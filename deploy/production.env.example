# Cấu hình và secret của ứng dụng ở production (TASK-160). Mô tả từng biến: docs/environment.md.
# Copy thành deploy/production.env trên máy chủ, chmod 600. KHÔNG commit file đó.
# Secret sinh bằng: openssl rand -hex 32

LOG_LEVEL=log

# Database trong container postgres (docker-compose.yml). Mật khẩu: openssl rand -hex 24
POSTGRES_USER=real_estate_os
POSTGRES_PASSWORD=
POSTGRES_DB=real_estate_os
# Cùng user/mật khẩu/tên ở trên, host là tên service "postgres"
DATABASE_URL=postgresql://real_estate_os:<POSTGRES_PASSWORD>@postgres:5432/real_estate_os

# Ít nhất 32 ký tự, khác khoá dev
JWT_SECRET=

# Email (bắt buộc ở production)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Ảnh BĐS (bắt buộc ở production): S3 / Cloudflare R2
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_URL=

# AI (để trống AI_API_KEY thì tắt các tính năng AI)
AI_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=
AI_TIMEOUT_MS=
AI_USER_DAILY_LIMIT=

# Push notification: JSON service account Firebase mã hoá base64 (để trống thì tắt)
FCM_CONFIG=

# Số liệu cho Prometheus. Ghi cùng giá trị vào deploy/secrets/metrics_token (docs/deployment.md)
METRICS_TOKEN=

# Sao lưu (docs/backup.md): bucket riêng, khoá riêng chỉ có quyền ghi và đọc
BACKUP_BUCKET=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_ENDPOINT=
BACKUP_REGION=auto
BACKUP_FORCE_PATH_STYLE=false
BACKUP_PREFIX=database/
BACKUP_KEEP_DAYS=7
BACKUP_HEARTBEAT_URL=
