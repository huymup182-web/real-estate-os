# Giá trị mặc định cho môi trường phát triển local.
# File này ĐƯỢC commit, nên chỉ chứa giá trị dev không nhạy cảm.
# Secret thật và giá trị riêng của từng máy đặt trong .env (không commit), .env ghi đè file này.

NODE_ENV=development

# PostgreSQL trong docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=real_estate_os
POSTGRES_PORT=5432

# Cổng mở ra máy host
BACKEND_PORT=3000
ADMIN_PORT=3001

# Kết nối database khi chạy backend trực tiếp trên máy (ngoài Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_estate_os

# Chỉ dùng cho dev local. Môi trường khác bắt buộc đặt giá trị ngẫu nhiên trong .env
JWT_SECRET=dev-only-insecure-jwt-secret-change-me

# Để trống ở dev: tính năng tương ứng chưa được dùng (storage TASK-057, AI TASK-133, FCM TASK-093)
STORAGE_KEY=
AI_API_KEY=
FCM_CONFIG=
