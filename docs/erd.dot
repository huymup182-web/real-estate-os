// ERD — AI Real Estate OS (TASK-006). Nguồn của docs/erd.png.
// Tạo lại ảnh: sh scripts/generate-erd.sh. Chi tiết cột: docs/database.md
digraph erd {
  graph [rankdir=LR, splines=true, overlap=false, nodesep=0.35, ranksep=1.1, fontname="DejaVu Sans", fontsize=20, labelloc=t, label="AI Real Estate OS — ERD (tenant_id = companies.id ở mọi bảng nghiệp vụ)"];
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=11];
  edge [arrowhead=tee, arrowtail=crow, dir=both, color="#5f6368", fontname="DejaVu Sans", fontsize=9];
  subgraph cluster_0 {
    label="Tổ chức"; style="rounded,filled"; fillcolor="#E8F0FE"; color="#bdc1c6"; fontsize=14;
    companies [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>companies</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">name</td></tr><tr><td align="left">slug UQ</td></tr><tr><td align="left">status</td></tr><tr><td align="left">settings jsonb</td></tr></table>>];
    departments [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>departments</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">name</td></tr><tr><td align="left">manager_id FK</td></tr></table>>];
    teams [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>teams</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">department_id FK</td></tr><tr><td align="left">name</td></tr><tr><td align="left">leader_id FK</td></tr></table>>];
    team_members [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>team_members</b></font></td></tr><tr><td align="left">team_id PK,FK</td></tr><tr><td align="left">user_id PK,FK</td></tr><tr><td align="left">tenant_id FK</td></tr></table>>];
  }
  subgraph cluster_1 {
    label="Người dùng & phân quyền"; style="rounded,filled"; fillcolor="#FCE8E6"; color="#bdc1c6"; fontsize=14;
    users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>users</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK (null=platform)</td></tr><tr><td align="left">email UQ</td></tr><tr><td align="left">phone UQ</td></tr><tr><td align="left">password_hash</td></tr><tr><td align="left">department_id FK</td></tr><tr><td align="left">status</td></tr></table>>];
    roles [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>roles</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">code</td></tr><tr><td align="left">is_system</td></tr></table>>];
    user_roles [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>user_roles</b></font></td></tr><tr><td align="left">user_id PK,FK</td></tr><tr><td align="left">role_id PK,FK</td></tr></table>>];
    permissions [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>permissions</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">code UQ</td></tr><tr><td align="left">module</td></tr></table>>];
    role_permissions [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>role_permissions</b></font></td></tr><tr><td align="left">role_id PK,FK</td></tr><tr><td align="left">permission_id PK,FK</td></tr><tr><td align="left">scope</td></tr></table>>];
  }
  subgraph cluster_2 {
    label="Địa giới hành chính"; style="rounded,filled"; fillcolor="#E6F4EA"; color="#bdc1c6"; fontsize=14;
    provinces [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>provinces</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">code UQ</td></tr><tr><td align="left">name</td></tr></table>>];
    districts [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>districts</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">province_id FK</td></tr><tr><td align="left">code UQ</td></tr><tr><td align="left">name</td></tr></table>>];
    wards [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>wards</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">province_id FK</td></tr><tr><td align="left">district_id FK (null)</td></tr><tr><td align="left">code UQ</td></tr><tr><td align="left">name</td></tr></table>>];
  }
  subgraph cluster_3 {
    label="BĐS"; style="rounded,filled"; fillcolor="#FEF7E0"; color="#bdc1c6"; fontsize=14;
    owners [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>owners</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">full_name</td></tr><tr><td align="left">phone</td></tr></table>>];
    properties [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>properties</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">code</td></tr><tr><td align="left">title</td></tr><tr><td align="left">price bigint</td></tr><tr><td align="left">area</td></tr><tr><td align="left">bedrooms / bathrooms</td></tr><tr><td align="left">direction / road_width</td></tr><tr><td align="left">legal_status</td></tr><tr><td align="left">province_id / district_id / ward_id FK</td></tr><tr><td align="left">location geography</td></tr><tr><td align="left">status</td></tr><tr><td align="left">owner_id FK</td></tr><tr><td align="left">agent_id FK</td></tr><tr><td align="left">verification_status</td></tr></table>>];
    property_images [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>property_images</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">property_id FK</td></tr><tr><td align="left">storage_key</td></tr><tr><td align="left">sort_order</td></tr></table>>];
    property_documents [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>property_documents</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">property_id FK</td></tr><tr><td align="left">storage_key</td></tr></table>>];
    property_favorites [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>property_favorites</b></font></td></tr><tr><td align="left">user_id PK,FK</td></tr><tr><td align="left">property_id PK,FK</td></tr><tr><td align="left">tenant_id FK</td></tr></table>>];
    property_views [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>property_views</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">property_id FK</td></tr><tr><td align="left">user_id FK</td></tr></table>>];
  }
  subgraph cluster_4 {
    label="Khách hàng (CRM)"; style="rounded,filled"; fillcolor="#F3E8FD"; color="#bdc1c6"; fontsize=14;
    customers [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>customers</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">full_name</td></tr><tr><td align="left">phone</td></tr><tr><td align="left">agent_id FK</td></tr><tr><td align="left">status</td></tr></table>>];
    customer_preferences [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>customer_preferences</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">customer_id FK</td></tr><tr><td align="left">budget_min / max</td></tr><tr><td align="left">province_ids[]</td></tr><tr><td align="left">bedrooms_min</td></tr></table>>];
    customer_activities [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>customer_activities</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">customer_id FK</td></tr><tr><td align="left">user_id FK</td></tr><tr><td align="left">type</td></tr><tr><td align="left">occurred_at</td></tr></table>>];
  }
  subgraph cluster_5 {
    label="Giao dịch"; style="rounded,filled"; fillcolor="#E4F7FB"; color="#bdc1c6"; fontsize=14;
    appointments [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>appointments</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">customer_id FK</td></tr><tr><td align="left">property_id FK</td></tr><tr><td align="left">agent_id FK</td></tr><tr><td align="left">scheduled_at</td></tr><tr><td align="left">status</td></tr></table>>];
    deals [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>deals</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">customer_id FK</td></tr><tr><td align="left">property_id FK</td></tr><tr><td align="left">agent_id FK</td></tr><tr><td align="left">stage</td></tr><tr><td align="left">deal_price</td></tr></table>>];
    commissions [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>commissions</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">deal_id FK</td></tr><tr><td align="left">user_id FK</td></tr><tr><td align="left">amount</td></tr><tr><td align="left">status</td></tr></table>>];
  }
  subgraph cluster_6 {
    label="Hệ thống"; style="rounded,filled"; fillcolor="#F1F3F4"; color="#bdc1c6"; fontsize=14;
    saved_searches [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>saved_searches</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">user_id FK</td></tr><tr><td align="left">filters jsonb</td></tr></table>>];
    notifications [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>notifications</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">user_id FK</td></tr><tr><td align="left">type</td></tr><tr><td align="left">read_at</td></tr></table>>];
    audit_logs [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>audit_logs</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">tenant_id FK</td></tr><tr><td align="left">user_id FK</td></tr><tr><td align="left">action</td></tr><tr><td align="left">entity_type / entity_id</td></tr></table>>];
    refresh_tokens [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>refresh_tokens (TASK-040)</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">user_id FK</td></tr><tr><td align="left">token_hash UQ</td></tr><tr><td align="left">family_id</td></tr></table>>];
    password_reset_tokens [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>password_reset_tokens (TASK-042)</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">user_id FK</td></tr><tr><td align="left">token_hash UQ</td></tr></table>>];
    device_tokens [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#3c4043"><font color="white"><b>device_tokens (TASK-094)</b></font></td></tr><tr><td align="left">id PK</td></tr><tr><td align="left">user_id FK</td></tr><tr><td align="left">fcm_token UQ</td></tr></table>>];
  }
  departments -> companies;
  teams -> departments;
  team_members -> teams;
  team_members -> users;
  users -> companies;
  users -> departments;
  roles -> companies;
  user_roles -> users;
  user_roles -> roles;
  role_permissions -> roles;
  role_permissions -> permissions;
  districts -> provinces;
  wards -> provinces;
  wards -> districts;
  owners -> companies;
  properties -> companies;
  properties -> owners;
  properties -> users [label="agent"];
  properties -> wards;
  properties -> provinces;
  properties -> districts;
  property_images -> properties;
  property_documents -> properties;
  property_favorites -> properties;
  property_favorites -> users;
  property_views -> properties;
  property_views -> users;
  customers -> companies;
  customers -> users [label="agent"];
  customer_preferences -> customers;
  customer_activities -> customers;
  customer_activities -> users;
  appointments -> customers;
  appointments -> properties;
  appointments -> users [label="agent"];
  deals -> customers;
  deals -> properties;
  deals -> users [label="agent"];
  commissions -> deals;
  commissions -> users;
  saved_searches -> users;
  notifications -> users;
  audit_logs -> users;
  refresh_tokens -> users;
  password_reset_tokens -> users;
  device_tokens -> users;
}
