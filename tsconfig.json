// Typecheck các script Node ở thư mục gốc. Ứng dụng có tsconfig riêng.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["scripts/**/*.js", "scripts/**/*.ts", "scripts/**/*.mts", "*.mjs"]
}
